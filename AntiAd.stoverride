name: AntiAd
desc: Use the Loyalsoldier ruleset to block ad domains.
icon: https://raw.githubusercontent.com/RiverMud/Stash/refs/heads/master/Reject.png
category: AntiAd

rule-providers:
  reject:
    type: http
    behavior: domain
    format: text
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/surge-rules@release/reject.txt"
    path: ./rules/reject.txt
    interval: 86400

rules:
  - RULE-SET,reject,REJECT
